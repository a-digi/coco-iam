# Environment configuration for the React frontend (Vite).
#
# Two committed files cover the two modes:
#   .env.development  — used by `npm run dev` (localhost)
#   .env.production   — used by `npm run build` (production URLs)
#
# To override locally without touching the committed files, create
# .env.development.local or .env.production.local — both are gitignored.
#
# All VITE_-prefixed variables are inlined into the bundle at build time
# via import.meta.env. Never put secrets here.

VITE_API_BASE_URL=http://localhost:2026/api/v1/
VITE_FRONTEND_URL=http://localhost:5173
