{
  "port": 2026,
  "pid_file": "./server.pid",
  "auth": {
    "issuer": "https://issuer",
    "audience": "coco-iam",
    "hs256_secret": "dev-secret",
    "jwks_url": ""
  },
  "security": {
    "trust_proxy_ip_headers": ["X-Real-IP", "X-Forwarded-For", "CF-Connecting-IP", "True-Client-IP"],
    "rate_limit": {
      "global": { "requests": 300, "window_seconds": 60, "ban_seconds": 900 },
      "sensitive": { "requests": 15, "window_seconds": 300, "ban_seconds": 3600 },
      "sensitive_paths": [
        "/admin/oauth/authenticate", "/admin/oauth/renew",
        "/recovery/request", "/recovery/verify", "/recovery/reset",
        "/activation/verify", "/activation/activate",
        "/applications/authenticate", "/applications/renew",
        "/public/applications/recover/request", "/public/applications/recover/reset"
      ]
    }
  },
  "geoip": {
    "enabled": false,
    "db_path": "./data/db/security/geoip.db",
    "check_interval_seconds": 600,
    "pull_interval_hours": 24,
    "maxmind_account_id": "",
    "maxmind_license_key": "",
    "pid_file": "./data/geoip-updater.pid",
    "updater_binary_path": "./versions/geoipupdater"
  }
}